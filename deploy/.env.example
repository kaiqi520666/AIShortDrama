BACKEND_IMAGE=ai-short-drama-backend:latest
FRONTEND_IMAGE=ai-short-drama-frontend:latest
FRONTEND_PORT=8091

APP_ENV=production
DATABASE_URL=postgresql+asyncpg://mooncut:replace-me@db:5432/mooncut
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=mooncut
SECRET_KEY=replace-with-a-strong-random-secret

POSTGRES_USER=mooncut
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=mooncut

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_PUBLIC_BASE_URL=

TOAPIS_KEY=
TOAPIS_URL=https://toapis.com
VOLCENGINE_SPEECH_API_KEY=
VOLCENGINE_SPEECH_URL=https://openspeech.bytedance.com/api/v3/tts/create

AIJWS_API_KEY=
AIJWS_BASE_URL=https://api.aijws.com/v1
AIJWS_MODEL=gpt-5.6-sol
AIJWS_REASONING_EFFORT=high

ZPAY_PID=
ZPAY_KEY=
ZPAY_GATEWAY=https://zpayz.cn
ZPAY_NOTIFY_URL=https://mooncut.nodepass.net/api/recharge/zpay/notify
ZPAY_RETURN_URL=https://mooncut.nodepass.net/api/recharge/zpay/return
FRONTEND_BASE_URL=https://mooncut.nodepass.net
